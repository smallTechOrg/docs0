# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Anthropic (required to answer questions) ---
DOCS0_ANTHROPIC_API_KEY=
# Model id. Default: claude-sonnet-5-5
DOCS0_ANTHROPIC_MODEL=claude-sonnet-5-5
# USD per million tokens for the model above; used to compute cost per answer.
DOCS0_ANTHROPIC_INPUT_PRICE=2.00
DOCS0_ANTHROPIC_OUTPUT_PRICE=10.00
# Maximum model turns per question. Default: 12
DOCS0_AGENT_MAX_STEPS=12

# --- Spend cap ---
# Hard monthly cap in USD per company. docs0 stops answering once this month's logged cost reaches it.
# A company can have its own cap (tenant.monthly_budget_usd); this is the default. 0 = no cap.
DOCS0_MONTHLY_BUDGET_USD=100
# Monthly cap in USD of a company that installs docs0 itself (Add to Slack, multi-tenant mode). Default: 5.
# 0 refuses every question until the operator raises it:
#   UPDATE tenant SET monthly_budget_usd = 50 WHERE slug = '...';
# (NULL in that column means "use DOCS0_MONTHLY_BUDGET_USD"; 0 means no budget at all.)
DOCS0_NEW_TENANT_BUDGET_USD=5

# --- Slack (required for the bot; create the app from slack/manifest.yml) ---
# Bot User OAuth Token, starts with xoxb-. At startup docs0 registers this workspace for the configured
# tenant and stores the token encrypted, so DOCS0_ENCRYPTION_KEY must be set too.
DOCS0_SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope, starts with xapp-
DOCS0_SLACK_APP_TOKEN=
# --- Several companies (optional; leave all three blank for a single-company pilot) ---
# Create the Slack app from slack/manifest-distributed.yml. With all three set, docs0 serves any company that clicks
# Add to Slack: events arrive over HTTP, admins sign in with Slack. DOCS0_PUBLIC_URL must then be a public https URL.
# Basic Information -> App Credentials.
DOCS0_SLACK_CLIENT_ID=
DOCS0_SLACK_CLIENT_SECRET=
# Basic Information -> Signing Secret. Verifies every request Slack sends to /slack/events and /slack/interactions;
# blank = those endpoints reject everything. Also needed by the single-company HTTP transport below.
DOCS0_SLACK_SIGNING_SECRET=
# How Slack reaches the single-company app: socket (Socket Mode, the laptop pilot, default) or http (hosted on Cloud
# Run: events and button clicks arrive at /slack/events and /slack/interactions; needs DOCS0_SLACK_BOT_TOKEN and
# DOCS0_SLACK_SIGNING_SECRET, no app-level token). In http mode a request is held open until its work is finished.
# DOCS0_SLACK_TRANSPORT=socket
# http mode: most seconds a Slack request is held open (keep under the Cloud Run request timeout, 300). Default: 270
# DOCS0_SLACK_HOLD_OPEN_SECONDS=270
# Days of channel history the Slack history source indexes (chosen channels only, chosen on the Sources
# page; direct messages are never indexed). Default: 180
DOCS0_SLACK_HISTORY_DAYS=180

# --- Proactive answers, stale documents and the weekly digest ---
# Channels where docs0 answers repeat questions are chosen on the Channels page (/admin/channels); none by default.
# Most unprompted answers per channel per hour. Default: 3
DOCS0_PROACTIVE_MAX_PER_HOUR=3
# An answer that cites a document last updated more than this many days ago says it may be out of date. Default: 365
DOCS0_STALE_DAYS=365
# When the weekly digest is posted (Spring cron: second minute hour day-of-month month weekday). Nothing is posted
# until an admin picks a channel on the Insights page. "-" turns the schedule off. Default: 0 0 9 * * MON
DOCS0_DIGEST_CRON=0 0 9 * * MON
# Time zone of that schedule, for example Europe/London. Default: UTC
DOCS0_TIMEZONE=UTC

# --- Grain (optional) ---
# Grain is connected from the Sources page by pasting an access token; nothing is needed here except
# DOCS0_ENCRYPTION_KEY. Days of Grain recordings (notes and transcripts) to index. Default: 365
DOCS0_GRAIN_HISTORY_DAYS=365

# --- Gmail (optional) ---
# Gmail is connected from the Sources page by pasting a Google service account key (domain-wide
# delegation); nothing is needed here except DOCS0_ENCRYPTION_KEY. Each mailbox is private to its
# owner. Days of mail (threads) to index per mailbox. Default: 90
DOCS0_GMAIL_HISTORY_DAYS=90

# --- Google Drive (required to index docs) ---
# Drive is connected from the Sources page (/admin/sources) by signing in with Google.
# These three values are needed once per deployment.
# OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Register this redirect URI on the client: <DOCS0_PUBLIC_URL>/admin/sources/google/callback
DOCS0_GOOGLE_OAUTH_CLIENT_ID=
DOCS0_GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts the stored Google grant. Base64 of 32 random bytes: openssl rand -base64 32
# Changing it later means reconnecting Google Drive.
DOCS0_ENCRYPTION_KEY=
# Minutes between syncs. Default: 15
DOCS0_DRIVE_SYNC_INTERVAL_MINUTES=15
# Run a sync when the app starts. Default: true
DOCS0_DRIVE_SYNC_ON_STARTUP=true

# --- App ---
# First tenant. Defaults: smalltech / smallTech
DOCS0_TENANT_SLUG=smalltech
DOCS0_TENANT_NAME=smallTech
# HTTP port for the status page. Default: 8080
DOCS0_PORT=8080
# Where a browser reaches docs0. Default: http://localhost:<DOCS0_PORT>
DOCS0_PUBLIC_URL=http://localhost:8080
# Password for the /admin pages (sign in as user "admin"). Empty = /admin is served only to
# requests from this machine. Set it whenever docs0 is reachable by others or sits behind a proxy.
DOCS0_ADMIN_PASSWORD=
# Postgres. Defaults: jdbc:postgresql://localhost:5432/docs0, the current OS user, no password.
DOCS0_DATABASE_URL=jdbc:postgresql://localhost:5432/docs0
DOCS0_DATABASE_USER=
DOCS0_DATABASE_PASSWORD=

# --- Hosting (Cloud Run; see README "Deploying to Cloud Run") ---
# Cloud Run sets PORT, which wins over DOCS0_PORT.
# Create the database named in DOCS0_DATABASE_URL on start if it is missing (the role needs CREATEDB). Default: false
DOCS0_AUTO_CREATE_DATABASE=false
# Largest database connection pool. The shared Cloud SQL instance allows 90 connections for ~10 apps. Default: 5
DOCS0_DB_POOL_MAX=5
# With DOCS0_ADMIN_PASSWORD set, the status page "/" needs it too and /health returns only {"status":"UP"}.
# Hosted deploy only (all set by deploy/deploy.sh; the laptop pilot leaves them unset):
# DOCS0_SLACK_TRANSPORT=http          Slack events over HTTP (needs DOCS0_SLACK_SIGNING_SECRET), no Socket Mode
# DOCS0_SLACK_HOLD_OPEN_SECONDS=270   see the Slack section above
# DOCS0_INTERNAL_SCHEDULER=false      nothing runs on a timer in the service (no sync, no weekly digest); they run as
#                                     Cloud Run Jobs started by Cloud Scheduler. Default: true
# DOCS0_SYNC_JOB_NAME=docs0-sync      Cloud Run Job the Sources page "Sync now" button starts (empty: syncs in-process)
# DOCS0_GCP_PROJECT=ai-agent-boilerplate0   project and region of that job
# DOCS0_GCP_REGION=us-central1
# Jobs: the same image started with --docs0.job=sync (optionally --docs0.job.tenant=ID --docs0.job.source=ID) or
# --docs0.job=digest runs once without a web server and exits.
# Reserved, unused so far:
# DOCS0_CRON_TOKEN=
